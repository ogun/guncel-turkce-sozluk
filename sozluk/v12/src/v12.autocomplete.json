  </head>
  <body>
    <div id="root"></div>
    <script>
      (function () {
        try {
          var params = new URLSearchParams(location.search)
          var raw = params.get('ara') || params.get('kelime')
          if (!raw) return
          var term = String(raw).trim()
          if (!term) return
          if ((location.pathname || '/').indexOf('/kelime/') === 0) return
          location.replace('/kelime/' + encodeURIComponent(term))
        } catch (e) {}
      })()
    </script>
  </body>
